rules_version = '2';

// Reglas del comedor Mi Bandeja.
//
// El rol `superadmin` vive en un custom claim del token, que solo se puede
// escribir con el Admin SDK desde una máquina de confianza: nadie se lo puede
// dar a sí mismo desde la app. Los demás roles viven en el documento del
// usuario, donde solo el superadmin los puede cambiar. Así el superadmin
// reparte roles desde la app sin que eso abra ninguna puerta.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function esSuperadmin() {
      return autenticado() && request.auth.token.rol == 'superadmin';
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tengoPerfil() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Un rol solo vale si la cuenta además está activa: suspender a alguien le
    // saca los permisos en el acto, sin esperar a que cierre sesión.
    function esRol(nombres, institucionId) {
      return tengoPerfil()
        && miPerfil().get('rol', 'alumno') in nombres
        && miPerfil().get('estado', 'pendiente') == 'activo'
        && miPerfil().get('institucionId', '') == institucionId;
    }

    function esAdminDe(institucionId) {
      return esRol(['admin'], institucionId);
    }

    // Quienes marcan entradas en la puerta del comedor.
    function esPersonalDe(institucionId) {
      return esRol(['admin', 'encargado'], institucionId);
    }

    // Quienes ven la operativa del día, incluido el cocinero.
    function esEquipoDe(institucionId) {
      return esRol(['admin', 'encargado', 'cocinero'], institucionId);
    }

    // El catálogo se lee sin sesión: la app tiene que mostrarlo antes de que el
    // alumno tenga cuenta. No contiene datos personales.
    match /instituciones/{institucionId} {
      function camposDeConfiguracion() {
        return ['horarios', 'edadCorteChicoGrande', 'subroles', 'contadores'];
      }

      function cambios() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Los permisos vienen activados si el documento todavía no los declara.
      function permiteAlAdmin(clave) {
        return resource.data.get(['permisosDelAdmin', clave], true) == true;
      }

      allow read: if true;
      allow create, delete: if esSuperadmin();

      // El admin ajusta la operativa de su institución, y los precios solo si
      // el superadmin se lo habilitó. La identidad, el alta en el catálogo y
      // los permisos quedan del lado del superadmin.
      allow update: if esSuperadmin()
        || (
          esAdminDe(institucionId)
          && cambios().hasOnly(camposDeConfiguracion().concat(['precios']))
          && (!cambios().hasAny(['precios']) || permiteAlAdmin('ajustarPrecios'))
        );
    }

    match /usuarios/{uid} {
      function camposDeRegistro() {
        return [
          'nombre', 'apellido', 'ci', 'email', 'telefono', 'fechaNacimiento',
          'institucionId', 'rol', 'subrol', 'estado', 'tickets', 'creadoEn'
        ];
      }

      // Lo único que una persona puede cambiarse a sí misma es su foto.
      function camposDelPerfilPropio() {
        return ['fotoPerfil'];
      }

      function institucionActiva(institucionId) {
        return exists(/databases/$(database)/documents/instituciones/$(institucionId))
          && get(/databases/$(database)/documents/instituciones/$(institucionId)).data.activa == true;
      }

      // El encargado no administra créditos: lo único que puede hacer es gastar
      // uno, de a uno, al marcar una entrada.
      function descuentaUnTicket() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tickets'])
          && resource.data.tickets > 0
          && request.resource.data.tickets == resource.data.tickets - 1;
      }

      allow get: if esPropietario(uid)
        || esSuperadmin()
        || esEquipoDe(resource.data.institucionId);
      allow list: if esSuperadmin() || esEquipoDe(resource.data.institucionId);

      // Un registro nuevo entra siempre sin rol, sin subrol, sin permisos y sin
      // créditos, y solo contra una institución que existe y está activa. El
      // superadmin puede crear cuentas ya armadas para quien no pueda solo.
      allow create: if esSuperadmin()
        || (
          esPropietario(uid)
          && request.resource.data.keys().hasOnly(camposDeRegistro())
          && request.resource.data.keys().hasAll(camposDeRegistro())
          && request.resource.data.rol == 'alumno'
          && request.resource.data.subrol == null
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.tickets == 0
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.ci is string
          && request.resource.data.creadoEn == request.time
          && institucionActiva(request.resource.data.institucionId)
        );

      // Ni el admin puede repartir roles ni mover a nadie de institución: eso
      // es exclusivo del superadmin.
      allow update: if esSuperadmin()
        || (
          esPropietario(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(camposDelPerfilPropio())
        )
        || (
          request.resource.data.institucionId == resource.data.institucionId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol'])
          && (
            esAdminDe(resource.data.institucionId)
            || (esPersonalDe(resource.data.institucionId) && descuentaUnTicket())
          )
        );

      allow delete: if esSuperadmin() || esAdminDe(resource.data.institucionId);
    }

    // El menú no es dato personal: cualquier usuario con sesión puede leerlo.
    match /menus/{menuId} {
      allow read: if autenticado();
      allow create, update: if esRol(['cocinero', 'admin'], request.resource.data.institucionId);
      allow delete: if false;
    }

    match /asistencias/{asistenciaId} {
      function idEsperado(institucionId, fecha, usuarioId) {
        return asistenciaId == institucionId + '_' + fecha + '_' + usuarioId;
      }

      function camposDelEscaneo() {
        return ['estado', 'presenteEn', 'escaneadoPor', 'medioAcceso'];
      }

      function camposDelAlumno() {
        return ['estado', 'qrToken', 'comidas', 'confirmadoEn'];
      }

      allow get: if esPropietario(resource.data.usuarioId)
        || esEquipoDe(resource.data.institucionId);
      allow list: if esEquipoDe(resource.data.institucionId);

      // El alumno confirma su propia asistencia. No puede darse por presente:
      // eso solo pasa cuando alguien del comedor le escanea el código.
      allow create: if (
          esPropietario(request.resource.data.usuarioId)
          && idEsperado(
               request.resource.data.institucionId,
               request.resource.data.fecha,
               request.auth.uid
             )
          && request.resource.data.estado == 'confirmado'
        )
        || (
          esPersonalDe(request.resource.data.institucionId)
          && request.resource.data.estado == 'presente'
          && idEsperado(
               request.resource.data.institucionId,
               request.resource.data.fecha,
               request.resource.data.usuarioId
             )
        );

      allow update: if (
          esPropietario(resource.data.usuarioId)
          && resource.data.estado != 'presente'
          && request.resource.data.estado in ['confirmado', 'cancelado']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(camposDelAlumno())
        )
        || (
          esPersonalDe(resource.data.institucionId)
          && request.resource.data.estado == 'presente'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(camposDelEscaneo())
        );

      allow delete: if false;
    }

    // Registro de auditoría: se crea y no se toca nunca más. Esa inmutabilidad
    // es el argumento de transparencia sobre el dinero del comedor.
    match /pagos/{pagoId} {
      function adminPuedeVerPagos(institucionId) {
        return esAdminDe(institucionId)
          && get(/databases/$(database)/documents/instituciones/$(institucionId))
               .data.get(['permisosDelAdmin', 'verRegistroDePagos'], true) == true;
      }

      allow get, list: if esPropietario(resource.data.usuarioId)
        || esSuperadmin()
        || adminPuedeVerPagos(resource.data.institucionId);
      allow create: if esAdminDe(request.resource.data.institucionId)
        && request.resource.data.registradoPor == request.auth.uid
        && request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }
  }
}
